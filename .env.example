# Runtime (bare metal / self-host defaults)
# Keep HOST=127.0.0.1 unless a trusted reverse proxy is on the same host.
# The Docker image and compose file override HOST and DATABASE_PATH for the container.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
DATABASE_PATH=./data/notify.sqlite

# Generate once with: bun run src/index.ts vapid generate
# Store the private key as a secret. Never commit real keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Required on the first boot when no API tokens exist.
# Use at least 32 random characters, for example: openssl rand -base64 32
# Uncomment and set it for the first boot.
# NOTIFY_BOOTSTRAP_TOKEN=

# Security
TRUST_PROXY=false
MCP_ADMIN_ENABLED=false
LOG_LEVEL=info
RETENTION_DAYS=90
PUSH_TIMEOUT_MS=10000
PUSH_CONCURRENCY=8
# Comma-separated optional override of the push-service host allowlist.
PUSH_ENDPOINT_ALLOWLIST=

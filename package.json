{
  "name": "notify",
  "version": "0.1.0",
  "description": "Self-hosted Web Push notifications over HTTP, CLI, and MCP.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "notify": "./src/index.ts"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "bun run src/index.ts serve",
    "dev": "bun --hot src/index.ts serve --dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "notify": "bun run src/index.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "qrcode": "^1.5.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
